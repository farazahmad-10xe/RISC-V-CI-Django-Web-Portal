DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=192.168.100.150
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.100.150
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
PORTAL_TIME_ZONE=Asia/Karachi
PORTAL_INGEST_TOKEN=replace-with-a-separate-random-token
PORTAL_ARTIFACT_ROOT=/srv/riscv-results
DB_ENGINE=postgresql
DB_NAME=riscv_portal
DB_USER=riscv_portal
DB_PASSWORD=replace-with-the-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
